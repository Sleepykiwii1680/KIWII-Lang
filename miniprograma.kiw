>> programa minimo para el motor
vacio principal() {
    ent base = 2;
    ent altura = 3;
    ent area = base * altura;
    salida(area);
    texto saludo = "hola desde el motor";
    salida(saludo);
    si (area > 5) {
        salida("area grande");
    }
    si (area < 3) {
        salida("area chica");
    }
    area = area + 3;
    salida(area);
    retorna 0;
}
