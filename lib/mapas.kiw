>> diccionarios clave-valor
estructura Mapa {
    texto claves = "";
    texto valores = "";
    ent total = 0;
}

ent existeclave(clavesMapa, totalMapa, claveBuscada) {
    para (ent i = 0; i < totalMapa; i = i + 1) {
        texto k = obtener(clavesMapa, i);
        si (k == claveBuscada) {
            retorna 1;
        }
    }
    retorna 0;
}

vacio guardar(&clavesMapa, &valoresMapa, &totalMapa, clave, valor) {
    ent yaExiste = existeclave(clavesMapa, totalMapa, clave);

    si (yaExiste == 0) {
        ent tClaves = totalMapa;
        ent tValores = totalMapa;
        agregar(clavesMapa, tClaves, clave);
        agregar(valoresMapa, tValores, valor);
        totalMapa = totalMapa + 1;
    } demas {
        texto nuevasClaves = "";
        texto nuevosValores = "";
        ent nuevoTotal = 0;

        para (ent i = 0; i < totalMapa; i = i + 1) {
            texto k = obtener(clavesMapa, i);
            texto v = obtener(valoresMapa, i);

            ent tc = nuevoTotal;
            ent tv = nuevoTotal;
            agregar(nuevasClaves, tc, k);

            si (k == clave) {
                agregar(nuevosValores, tv, valor);
            } demas {
                agregar(nuevosValores, tv, v);
            }
            nuevoTotal = nuevoTotal + 1;
        }
        clavesMapa = nuevasClaves;
        valoresMapa = nuevosValores;
    }
}

texto buscar(clavesMapa, valoresMapa, totalMapa, claveBuscada) {
    para (ent i = 0; i < totalMapa; i = i + 1) {
        texto k = obtener(clavesMapa, i);
        si (k == claveBuscada) {
            texto val = obtener(valoresMapa, i);
            retorna val;
        }
    }
    retorna "";
}

vacio mostrarmapa(clavesMapa, valoresMapa, totalMapa) {
    para (ent i = 0; i < totalMapa; i = i + 1) {
        texto k = obtener(clavesMapa, i);
        texto v = obtener(valoresMapa, i);
        texto par = "  [" + k;
        par = par + "] => ";
        par = par + v;
        salida(par);
    }
}
