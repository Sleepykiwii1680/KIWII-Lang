>> libreria matematica base

ent abs(n) {
    si (n < 0) {
        ent inv = 0 - n;
        retorna inv;
    }
    retorna n;
}

ent mod(a, b) {
    ent div = a / b;
    ent mult = div * b;
    ent resto = a - mult;
    retorna resto;
}

ent pot(base, exp) {
    ent res = 1;
    para (ent i = 0; i < exp; i = i + 1) {
        res = res * base;
    }
    retorna res;
}

ent max(a, b) {
    si (a > b) {
        retorna a;
    }
    retorna b;
}

ent min(a, b) {
    si (a < b) {
        retorna a;
    }
    retorna b;
}