{
	"name": "kiwii-lang",
	"main": "./extension.js",
    "activationEvents": ["onLanguage:kiwii"],
	"publisher": "alessito",
	"displayName": "KIWII Language Support",
	"description": "Soporte oficial de sintaxis e iconos para KIWII (.kiw)",
	"version": "1.1.0",
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "kiwii",
				"aliases": [
					"KIWII",
					"kiwii"
				],
				"extensions": [
					".kiw"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./logo.png",
					"dark": "./logo.png"
				}
			}
		],
		"grammars": [
			{
				"language": "kiwii",
				"scopeName": "source.kiwii",
				"path": "./kiwii.tmLanguage.json"
			}
		]
	}
	
}
