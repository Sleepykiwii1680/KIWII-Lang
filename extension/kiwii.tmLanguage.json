{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KIWII",
  "scopeName": "source.kiwii",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-arrow.kiwii",
      "match": ">>.*$"
    },
    "directives": {
      "name": "keyword.control.directive.kiwii",
      "match": "#incluir\\b"
    },
    "strings": {
      "name": "string.quoted.double.kiwii",
      "begin": "\"",
      "end": "\""
    },
    "numbers": {
      "name": "constant.numeric.kiwii",
      "match": "\\b-?[0-9]+(\\.[0-9]+)?\\b"
    },
    "keywords": {
      "name": "keyword.control.kiwii",
      "match": "\\b(si|sino|demas|mientras|para|rompe|salta|retorna|intenta|excepto|nuevo|y|o)\\b"
    },
    "types": {
      "name": "storage.type.kiwii",
      "match": "\\b(ent|texto|dual|dec|vacio|estructura)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.kiwii",
      "match": "\\b(salida|entrada|largo|letra_en|codigo_ascii|leer_archivo)\\b"
    },
    "functions": {
      "name": "entity.name.function.kiwii",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
    },
    "operators": {
      "name": "keyword.operator.kiwii",
      "match": "(==|!=|<=|>=|=|\\+|-|\\*|/|<|>|!|&)"
    }
  }
}