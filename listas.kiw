>> manejo de listas dinamicas

estructura Lista {
    texto datos = "";
    ent total = 0;
}

vacio agregar(&datosLista, &totalLista, nuevoValor) {
    si (totalLista == 0) {
        datosLista = nuevoValor;
    } demas {
        datosLista = datosLista + "|";
        datosLista = datosLista + nuevoValor;
    }
    totalLista = totalLista + 1;
}

texto obtener(datosLista, indiceBuscado) {
    ent tam = largo(datosLista);
    ent actual = 0;
    texto temp = "";

    para (ent i = 0; i < tam; i = i + 1) {
        texto c = letraen(datosLista, i);
        si (c == "|") {
            si (actual == indiceBuscado) {
                retorna temp;
            }
            temp = "";
            actual = actual + 1;
        } demas {
            temp = temp + c;
        }
    }

    si (actual == indiceBuscado) {
        retorna temp;
    }
    retorna "";
}

vacio mostrarlista(datosLista, totalLista) {
    para (ent i = 0; i < totalLista; i = i + 1) {
        texto item = obtener(datosLista, i);
        texto fila = "[" + i;
        fila = fila + "] -> ";
        fila = fila + item;
        salida(fila);
    }
}